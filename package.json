{
  "name": "dsh-remote-hosts",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "pack:release": "npm run build && node scripts/pack-release.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node test/integration.mjs",
    "test:interactions": "node test/native-interactions.mjs && node test/question-cancel.mjs",
    "test:reconnect": "node test/reconnect.mjs",
    "test:ssh": "node test/ssh-integration.mjs",
    "test:sidebar": "node test/sidebar.mjs",
    "test:sidebar-status": "node test/sidebar-status.mjs",
    "test:sidebar-height": "node test/sidebar-height.mjs",
    "test:hosts": "node test/host-manager.mjs",
    "test:paths": "node test/path-completion.mjs",
    "test:new-session": "node test/new-session.mjs",
    "test:compatibility": "node test/compatibility.mjs",
    "test:password": "node test/ssh-password.mjs",
    "test:installation": "node test/installation-consent.mjs",
    "test:runtime": "node test/runtime-discovery.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-crypto": "0.2.2-rc.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.58.2"
  },
  "description": "SSH gateway and native DSH conversations for remote hosts",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "PROGRESS.md",
    "PROJECT.md",
    "ROADMAP.md",
    "INSTALL.md",
    "B-INTEGRATION.md",
    "B-PLUGIN-DESIGN.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Castleeee/dsh-remote-hosts.git"
  },
  "homepage": "https://github.com/Castleeee/dsh-remote-hosts#readme",
  "bugs": {
    "url": "https://github.com/Castleeee/dsh-remote-hosts/issues"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1 || 0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "morphdom": "^2.7.8",
    "shell-quote": "^1.12.0",
    "ssh-config": "^5.3.0"
  }
}
